<?xml version='1.0' encoding='utf-8'?>
<?ifndef MsiVersion ?>
<?define MsiVersion = "0.3.0" ?>
<?endif?>
<!--
  OpacusR Windows MSI (WiX Toolset v3.11 — the same version the Release
  workflow installs). Authoring is strictly WiX v3: v4-only elements such
  as <StandardDirectory> are NOT valid here, the classic TARGETDIR tree is
  used instead (ProgramFiles64Folder / ProgramMenuFolder are Windows
  Installer folder properties referenced by Directory Id).

  Build from the repository root on a Windows host:

      cargo build (release profile) for opacusr-app, opacusr-agent, opacusr-server
      candle.exe -arch x64 -dMsiVersion=0.3.0 wix\main.wxs -o build\main.wixobj
      light.exe -ext WixUIExtension build\main.wixobj -o opacusr-0.3.0-x64.msi

  The product version comes from the -dMsiVersion preprocessor variable;
  the Release workflow derives it from the pushed tag (see
  .github/workflows/release.yml). Without it the <?ifndef> default above
  applies. Components are marked Win64 because candle runs with
  -arch x64 and the files land under ProgramFiles64Folder (otherwise
  light fails ICE80).
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Name='OpacusR'
        Id='*'
        UpgradeCode='c5e26ccb-434f-4f92-b458-45d633daa505'
        Language='1033'
        Codepage='1252'
        Version='$(var.MsiVersion)'
        Manufacturer='OpacusR contributors'>

        <Package
            InstallerVersion='200'
            Compressed='yes'
            InstallScope='perMachine'
            Description='OpacusR - self-hosted open-source remote desktop'
            Manufacturer='OpacusR contributors'/>

        <MajorUpgrade DowngradeErrorMessage='A newer version of [ProductName] is already installed.'/>
        <MediaTemplate EmbedCab='yes'/>

        <Icon Id='opacusr.ico' SourceFile='assets\opacusr.ico'/>
        <Property Id='ARPPRODUCTICON' Value='opacusr.ico'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/opacusio/opacusr'/>

        <Feature Id='ProductFeature' Title='OpacusR' Level='1'>
            <ComponentGroupRef Id='ProductComponents'/>
            <ComponentRef Id='StartMenuShortcut'/>
            <ComponentRef Id='AutoStartRun'/>
        </Feature>

        <UI>
            <UIRef Id='WixUI_Minimal'/>
            <!-- TeamViewer model, part 2: a fresh setup visibly opens
                 the app (checkbox on the final page, checked by
                 default). The WixShellExec standard custom action runs
                 in the installing user's session; a failed launch never
                 fails the install (Return='ignore'). -->
            <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT' Value='Запустить OpacusR'/>
            <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOX' Value='1'/>
            <Property Id='WixShellExecTarget' Value='[BinDir]opacusr.exe'/>
            <CustomAction Id='LaunchGuiAfterInstall' BinaryKey='WixCA' DllEntry='WixShellExec' Impersonate='yes' Return='ignore'/>
            <Publish Dialog='ExitDialog' Control='Finish' Event='DoAction' Value='LaunchGuiAfterInstall'>WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
        </UI>
        <WixVariable Id='WixUILicenseRtf' Value='assets\license.rtf'/>

        <!-- TeamViewer model, part 1: the MSI registers AND STARTS the
             host-agent Windows service (auto-start on boot) via the
             native ServiceInstall / ServiceControl elements below; the
             same registration the agent CLI performs with
             "opacusr-agent.exe service install". NOTE: no Arguments 
             attribute. The SCM inserts the service name as argv[1] when
             it starts the process; extra launch arguments would land
             after it and the agent CLI would never see them (the
             dispatcher needs the bare exe ImagePath). -->

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='ProgramFiles64Folder'>
                <Directory Id='INSTALLDIR' Name='OpacusR'>
                    <Directory Id='BinDir' Name='bin'/>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='AppMenu' Name='OpacusR'>
                    <Component Id='StartMenuShortcut' Guid='*' Win64='yes'>
                        <Shortcut
                            Id='ViewerStartMenu'
                            Name='OpacusR'
                            Description='OpacusR remote desktop'
                            Target='[BinDir]opacusr.exe'
                            WorkingDirectory='BinDir'
                            Icon='opacusr.ico'/>
                        <RemoveFolder Id='AppMenuDir' On='uninstall'/>
                        <RegistryValue Root='HKCU' Key='Software\OpacusR' Name='shortcut' Type='integer' Value='1' KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <ComponentGroup Id='ProductComponents' Directory='BinDir'>
            <Component Id='ViewerExecutable' Guid='17cf64b6-5991-4f8a-8193-f78e2135a9f3' Win64='yes'>
                <File Id='OpacusRExe' Source='target\release\opacusr.exe' KeyPath='yes'/>
            </Component>
            <Component Id='AgentExecutable' Guid='*' Win64='yes'>
                <File Id='OpacusRAgentExe' Source='target\release\opacusr-agent.exe' KeyPath='yes'/>
                <!-- The service binary is this component's key file.
                     The ImagePath is the bare exe: the SCM passes the
                     service name as argv[1] (see the note above and
                     win_service::install). Start='install' leaves the
                     machine reachable right after setup, not after the
                     next reboot. -->
                <ServiceInstall
                    Id='OpacusRAgentServiceInstall'
                    Name='OpacusRAgent'
                    DisplayName='OpacusR Agent'
                    Description='OpacusR remote-desktop host agent: supervises a per-session agent instance in the active console session.'
                    Type='ownProcess'
                    Start='auto'
                    ErrorControl='normal'/>
                <ServiceControl
                    Id='OpacusRAgentServiceControl'
                    Name='OpacusRAgent'
                    Start='install'
                    Stop='both'
                    Remove='uninstall'
                    Wait='yes'/>
            </Component>
            <Component Id='ServerExecutable' Guid='*' Win64='yes'>
                <File Id='OpacusRServerExe' Source='target\release\opacusr-server.exe' KeyPath='yes'/>
            </Component>
            <!-- TeamViewer-style autostart: HKLM Run starts the GUI
                 (hidden to the tray via the tray flag) at every user
                 login; the GUI then starts the host agent itself
                 (start_agent_automatically). A real Windows SERVICE is
                 deliberately not installed: screen capture and input
                 injection must run in the user session (Session 0 has
                 no desktop), so the login autostart is the correct
                 mechanism here. -->
            <Component Id='AutoStartRun' Guid='7f1c2d64-9b3e-4c8a-a5f1-2e6b8d4a9c31' Win64='yes'>
                <RegistryValue
                    Root='HKLM'
                    Key='Software\Microsoft\Windows\CurrentVersion\Run'
                    Name='OpacusR'
                    Type='string'
                    Value='&quot;[BinDir]opacusr.exe&quot; --tray'
                    KeyPath='yes'/>
            </Component>
        </ComponentGroup>
    </Product>
</Wix>
