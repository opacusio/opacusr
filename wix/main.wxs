<?xml version='1.0' encoding='utf-8'?>
<?ifndef MsiVersion ?>
<?define MsiVersion = "0.13.1" ?>
<?endif?>
<!--
  OpacusR Windows MSI (WiX Toolset v3.11 — the same version the Release
  workflow installs). Authoring is strictly WiX v3: v4-only elements such
  as <StandardDirectory> are NOT valid here, the classic TARGETDIR tree is
  used instead (ProgramFiles64Folder / ProgramMenuFolder are Windows
  Installer folder properties referenced by Directory Id).

  Build from the repository root on a Windows host:

      cargo build (release profile) for opacusr-app, opacusr-agent, opacusr-server
      candle.exe -arch x64 -dMsiVersion=0.11.25 wix\main.wxs -o build\main.wixobj
      light.exe -ext WixUIExtension build\main.wixobj -o opacusr-0.11.25-x64.msi

  The product version comes from the -dMsiVersion preprocessor variable;
  the Release workflow derives it from the pushed tag (see
  .github/workflows/release.yml). Without it the <?ifndef> default above
  applies. Components are marked Win64 because candle runs with
  -arch x64 and the files land under ProgramFiles64Folder (otherwise
  light fails ICE80).
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'
     xmlns:fire='http://schemas.microsoft.com/wix/FirewallExtension'>
    <Product
        Name='OpacusR'
        Id='*'
        UpgradeCode='c5e26ccb-434f-4f92-b458-45d633daa505'
        Language='1033'
        Codepage='1252'
        Version='$(var.MsiVersion)'
        Manufacturer='OpacusR contributors'>

        <Package
            InstallerVersion='200'
            Compressed='yes'
            InstallScope='perMachine'
            Description='OpacusR - self-hosted open-source remote desktop'
            Manufacturer='OpacusR contributors'/>

        <!-- Schedule='afterInstallInitialize' is the transactional upgrade:
             the old version is removed INSIDE the install transaction, so a
             failed update rolls back to the previous working build. The
             default (afterInstallValidate) deleted the old version first —
             a failed install left the machine WITHOUT OpacusR. -->
        <MajorUpgrade Schedule='afterInstallInitialize' DowngradeErrorMessage='A newer version of [ProductName] is already installed.'/>
        <MediaTemplate EmbedCab='yes'/>

        <Icon Id='opacusr.ico' SourceFile='assets\opacusr.ico'/>
        <Property Id='ARPPRODUCTICON' Value='opacusr.ico'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/opacusio/opacusr'/>

        <Feature Id='ProductFeature' Title='OpacusR' Level='1'>
            <ComponentGroupRef Id='ProductComponents'/>
            <ComponentRef Id='StartMenuShortcut'/>
            <ComponentRef Id='AutoStartRun'/>
        </Feature>

        <UI>
            <UIRef Id='WixUI_Minimal'/>
            <!-- TeamViewer model, part 2: a fresh setup visibly opens
                 the app (checkbox on the final page, checked by
                 default). The standard WixShellExec action runs in the
                 installing user's session; a failed launch never fails
                 the install (Return='ignore'). NOTE: the CustomAction
                 itself must live at Product level (CNDL0005 inside UI). -->
            <!-- Latin-only: the MSI summary database is codepage 1252
                 (Product/@Codepage); Cyrillic here fails LGHT0311. The
                 wizard itself is English (Language 1033). -->
            <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT' Value='Launch OpacusR'/>
            <Property Id='WIXUI_EXITDIALOGOPTIONALCHECKBOX' Value='1'/>
            <!-- [#OpacusRExe] resolves to the installed viewer exe (the
                 File KeyPath of the ViewerExecutable component). -->
            <Property Id='WixShellExecTarget' Value='[#OpacusRExe]'/>
            <Publish Dialog='ExitDialog' Control='Finish' Event='DoAction' Value='LaunchGuiAfterInstall'>WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
        </UI>
        <CustomAction Id='LaunchGuiAfterInstall' BinaryKey='WixCA' DllEntry='WixShellExec' Impersonate='yes' Return='ignore'/>
        <WixVariable Id='WixUILicenseRtf' Value='assets\license.rtf'/>

        <!-- TeamViewer model, part 3: an update must never end in
             «The setup was unable to automatically close all requested
             applications». That Windows Installer notice is shown by
             the Restart Manager check at InstallValidate, BEFORE the
             transaction opens — and three things make it unavoidable
             for us at that point:

             * ServiceControl Stop below only runs once the
               transaction is open (after InstallInitialize), i.e.
               after the Restart Manager has already failed;
             * the per-session agent child is a console process — the
               Restart Manager has no polite close for console apps;
             * the GUI hides to the tray (close-to-tray cancels
               WM_CLOSE), so the RM's polite close of opacusr.exe
               fails too.

             So the setup closes everything itself, a few actions
             before InstallValidate: `sc stop OpacusRAgent` lets the
             supervisor log a graceful exit to
             C:\ProgramData\OpacusR\service.log, then taskkill /F /T
             removes whatever is still holding opacusr.exe,
             opacusr-agent.exe or opacusr-server.exe (the service
             process, the per-session child, a GUI-spawned agent or a
             portable copy from another folder — any of them locks the
             files being replaced). SCM marks the service stopped when
             its process dies, and the kill-on-close job object reaps
             the child; nothing restarts the processes here (HKLM Run
             is logon-triggered, the service has no failure actions).
             After the files are replaced, ServiceControl
             re-registers and starts the service and the exit-dialog
             checkbox relaunches the GUI.

             Mechanics (WiX v3 WixUtilExtension, already linked by the
             Release workflow):

             * Immediate custom actions scheduled before
               InstallValidate run under the installing (elevated)
               user's token — enough to stop the service and kill
               other users' processes. A DEFERRED action cannot be
               used here: deferred actions must run inside the
               transaction (after InstallInitialize), which is past
               the Restart Manager check (and fails with error 2762
               when scheduled before it).
             * WixQuietExec runs each command line without a console
               window flash. A deferred WixQuietExec reads its command
               from CustomActionData; the immediate one reads the
               WixQuietExecCmdLine property and CLEARS it after use
               (src/ext/ca/wixca/dll/qtexecca.cpp), so each command
               needs its own setter action immediately before it.
             * The setter values are formatted fields: [SystemFolder]
               expands to the 64-bit System32 (candle -arch x64), and
               the command must START with a quoted path or QuietExec
               rejects it.
             * Return='ignore': a fresh install (nothing running) or
               an already-stopped service must never block setup —
               taskkill returns 128 and sc stop returns 1062 in that
               case.

             These actions also make plain uninstall quiet: it used to
             leave the tray GUI running and ask for a reboot for the
             same files-in-use reason. -->
        <CustomAction
            Id='StopAgentService_Cmd'
            Property='WixQuietExecCmdLine'
            Value='&quot;[SystemFolder]sc.exe&quot; stop OpacusRAgent'/>
        <CustomAction
            Id='StopAgentService'
            BinaryKey='WixCA'
            DllEntry='WixQuietExec'
            Return='ignore'/>
        <CustomAction
            Id='KillViewer_Cmd'
            Property='WixQuietExecCmdLine'
            Value='&quot;[SystemFolder]taskkill.exe&quot; /F /T /IM opacusr.exe'/>
        <CustomAction
            Id='KillViewer'
            BinaryKey='WixCA'
            DllEntry='WixQuietExec'
            Return='ignore'/>
        <CustomAction
            Id='KillAgent_Cmd'
            Property='WixQuietExecCmdLine'
            Value='&quot;[SystemFolder]taskkill.exe&quot; /F /T /IM opacusr-agent.exe'/>
        <CustomAction
            Id='KillAgent'
            BinaryKey='WixCA'
            DllEntry='WixQuietExec'
            Return='ignore'/>
        <CustomAction
            Id='KillServer_Cmd'
            Property='WixQuietExecCmdLine'
            Value='&quot;[SystemFolder]taskkill.exe&quot; /F /T /IM opacusr-server.exe'/>
        <CustomAction
            Id='KillServer'
            BinaryKey='WixCA'
            DllEntry='WixQuietExec'
            Return='ignore'/>
        <InstallExecuteSequence>
            <Custom Action='StopAgentService_Cmd' Before='StopAgentService'/>
            <Custom Action='StopAgentService' Before='KillViewer_Cmd'/>
            <Custom Action='KillViewer_Cmd' Before='KillViewer'/>
            <Custom Action='KillViewer' Before='KillAgent_Cmd'/>
            <Custom Action='KillAgent_Cmd' Before='KillAgent'/>
            <Custom Action='KillAgent' Before='KillServer_Cmd'/>
            <Custom Action='KillServer_Cmd' Before='KillServer'/>
            <Custom Action='KillServer' Before='InstallValidate'/>
        </InstallExecuteSequence>

        <!-- TeamViewer model, part 1: the MSI registers AND STARTS the
             host-agent Windows service (auto-start on boot) via the
             native ServiceInstall / ServiceControl elements below; the
             same registration the agent CLI performs with
             "opacusr-agent.exe service install". The agent enters the
             SCM dispatcher before the CLI parser on every start and
             only falls back to the CLI when the caller is not the SCM
             (error 1063), so the bare-exe ImagePath needs no launch
             arguments. -->

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='ProgramFiles64Folder'>
                <Directory Id='INSTALLDIR' Name='OpacusR'>
                    <Directory Id='BinDir' Name='bin'/>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='AppMenu' Name='OpacusR'>
                    <Component Id='StartMenuShortcut' Guid='*' Win64='yes'>
                        <Shortcut
                            Id='ViewerStartMenu'
                            Name='OpacusR'
                            Description='OpacusR remote desktop'
                            Target='[BinDir]opacusr.exe'
                            WorkingDirectory='BinDir'
                            Icon='opacusr.ico'/>
                        <RemoveFolder Id='AppMenuDir' On='uninstall'/>
                        <RegistryValue Root='HKCU' Key='Software\OpacusR' Name='shortcut' Type='integer' Value='1' KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <ComponentGroup Id='ProductComponents' Directory='BinDir'>
            <Component Id='ViewerExecutable' Guid='17cf64b6-5991-4f8a-8193-f78e2135a9f3' Win64='yes'>
                <File Id='OpacusRExe' Source='target\release\opacusr.exe' KeyPath='yes'/>
                <!-- Program-scoped inbound exceptions (no ports: the
                     app owns signaling 8080, relay 8081, direct LAN
                     54000 and ephemeral WebRTC ICE ports). Without
                     them Windows Firewall silently drops the very
                     first inbound packet from a phone on the same
                     Wi-Fi — the remote side sees timeouts while
                     everything on localhost works. -->
                <fire:FirewallException Id='OpacusRAppFwTcp' Name='OpacusR' Scope='any' Profile='all' Protocol='tcp' File='OpacusRExe'/>
                <fire:FirewallException Id='OpacusRAppFwUdp' Name='OpacusR' Scope='any' Profile='all' Protocol='udp' File='OpacusRExe'/>
            </Component>
            <Component Id='AgentExecutable' Guid='*' Win64='yes'>
                <File Id='OpacusRAgentExe' Source='target\release\opacusr-agent.exe' KeyPath='yes'/>
                <!-- Same story for the service binary: unattended
                     sessions are inbound TCP (signaling registry,
                     relay, direct ip:port). -->
                <fire:FirewallException Id='OpacusRAgentFwTcp' Name='OpacusR Agent' Scope='any' Profile='all' Protocol='tcp' File='OpacusRAgentExe'/>
                <fire:FirewallException Id='OpacusRAgentFwUdp' Name='OpacusR Agent' Scope='any' Profile='all' Protocol='udp' File='OpacusRAgentExe'/>
                <!-- The service binary is this component's key file.
                     The ImagePath is the bare exe (the agent routes
                     itself into the SCM dispatcher on start; see the
                     note above and win_service::install). Start='auto'
                     leaves the machine reachable right after setup,
                     not after the next reboot. -->
                <!-- ErrorControl='ignore': a failure to start the
                     service here can never block or roll back the
                     installation (the old 'normal' turned any start
                     hiccup into the blocking Retry/Cancel dialog 1923).
                     The GUI shows the live service state and
                     C:\ProgramData\OpacusR\service.log keeps the
                     diagnostics. -->
                <ServiceInstall
                    Id='OpacusRAgentServiceInstall'
                    Name='OpacusRAgent'
                    DisplayName='OpacusR Agent'
                    Description='OpacusR remote-desktop host agent: supervises a per-session agent instance in the active console session.'
                    Type='ownProcess'
                    Start='auto'
                    ErrorControl='ignore'/>
                <!-- Remove='both': DeleteServices runs right before
                     InstallServices, so a stale registration left over
                     from an older build or a manual CLI install is
                     stopped and deleted first and can never make the
                     fresh registration fail with "service already
                     exists". Stop='both' covers upgrades too. -->
                <ServiceControl
                    Id='OpacusRAgentServiceControl'
                    Name='OpacusRAgent'
                    Start='install'
                    Stop='both'
                    Remove='both'
                    Wait='yes'/>
            </Component>
            <Component Id='ServerExecutable' Guid='*' Win64='yes'>
                <File Id='OpacusRServerExe' Source='target\release\opacusr-server.exe' KeyPath='yes'/>
            </Component>
            <!-- TeamViewer-style autostart: HKLM Run starts the GUI at
                 every user login WITH A VISIBLE WINDOW (TeamViewer opens
                 its window at logon too). The GUI starts the host agent
                 itself (start_agent_automatically) — or defers to the
                 already-running OpacusRAgent service (the service-aware
                 home card shows «служба работает»). A bare tray-flag
                 autostart was removed on purpose: a window that never
                 appears at logon reads as «приложение запустилось и
                 висит в трее, не выходит». The GUI still honors the
                 tray flag for anything that explicitly launches it that way. -->
            <Component Id='AutoStartRun' Guid='7f1c2d64-9b3e-4c8a-a5f1-2e6b8d4a9c31' Win64='yes'>
                <RegistryValue
                    Root='HKLM'
                    Key='Software\Microsoft\Windows\CurrentVersion\Run'
                    Name='OpacusR'
                    Type='string'
                    Value='&quot;[BinDir]opacusr.exe&quot;'
                    KeyPath='yes'/>
            </Component>
        </ComponentGroup>
    </Product>
</Wix>
